# =============================================================================
# AWS Bedrock Configuration
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
# Required for Bedrock. No default — verify model availability and access
# for your account and region before setting.
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Optional Bedrock inference defaults (omitted from requests when blank)
BEDROCK_TEMPERATURE=
BEDROCK_MAX_TOKENS=

# =============================================================================
# Qdrant Vector Store
# =============================================================================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=austenancy_tenancy_acts

# =============================================================================
# LLM Provider (DeepSeek via OpenAI-compatible SDK)
# =============================================================================
# Provider selection: deepseek (default when unset/blank) | bedrock
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
LLM_MODEL_ID=deepseek-chat

# =============================================================================
# LLM Fallback Providers
# =============================================================================
OPENAI_API_KEY=
GOOGLE_API_KEY=

# =============================================================================
# LangSmith Tracing (Optional) — see docs/LANGSMITH_SETUP.md
# =============================================================================
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aus-tenancy-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=false

# =============================================================================
# Application Configuration
# =============================================================================
LOG_LEVEL=INFO
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K_RETRIEVAL=10
TOP_K_RERANK=5

# =============================================================================
# Mem0 Cross-Session Memory (Optional) — see docs/AGENT_WORKFLOW.md §5
# =============================================================================
MEM0_API_KEY=
MEM0_ORG_ID=
